{
  "name": "ka-teng",
  "description": "Open-source family lineage visualiser with a 2D family tree and a clean 2D friends social graph.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "validate": "npm run lint && npm test && npm run test:e2e && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/newsreader": "5.2.8",
    "d3": "^7.9.0",
    "family-chart": "0.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "24.13.4",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "d3-hierarchy": "^3.1.2",
    "oxlint": "1.83.0",
    "typescript": "~6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "license": "MIT"
}
